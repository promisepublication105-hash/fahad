# Copy this file to .env and fill in the values you have.
# The app works without every key filled in — see README.md for what each
# one unlocks and where to get it.

# --- Required for transcription (English speech -> text) and translation
# (English -> Bangla). Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
TRANSCRIPTION_MODEL=whisper-1
TRANSLATION_MODEL=gpt-4o-mini

# --- Required for generating the Bangla voice. Enable the "Cloud
# Text-to-Speech API" in a Google Cloud project, create a service account
# with the "Cloud Text-to-Speech User" role, download its JSON key, and
# point this at the file path.
GOOGLE_APPLICATION_CREDENTIALS=
TTS_LANGUAGE_CODE=bn-IN
TTS_VOICE_NAME=bn-IN-Wavenet-A

# --- Optional: real lip-sync (matches mouth movement to the new Bangla
# audio). Without these two set, the app still works — it just ships the
# video with the original English lip movements. Get a key at
# https://sync.so
SYNC_API_KEY=
SYNC_MODEL=lipsync-2
# A public HTTPS URL this server is reachable at (sync.so fetches your
# video/audio from it). Use an ngrok/cloudflared tunnel locally, or your
# real domain once deployed.
PUBLIC_BASE_URL=

# --- Misc
STORAGE_DIR=storage
